# Same Postgres database the PHP app used - no data migration required.
DATABASE_URL="postgresql://user:password@host:5432/auc_mis_repair?sslmode=require"

# Random 32+ char secret used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET="replace-me"

# Base64-encoded 32-byte key for AES-256-GCM credential encryption (outlook
# passwords). MUST be the same value the original PHP app's CREDENTIAL_KEY
# used, or existing encrypted credentials won't decrypt.
# Generate a NEW one only for a fresh install: openssl rand -base64 32
CREDENTIAL_KEY="replace-me"

# Shared secret for the scheduled repair-deadline sync endpoint
# (GET/POST /api/cron/sync-repair-deadlines). Whatever scheduler triggers
# it (Railway Cron Job, GitHub Actions cron, cron-job.org, etc.) must send
# this as `Authorization: Bearer <value>` or `?secret=<value>`.
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-me"

# Optional. Base URL the self-ping loop (src/instrumentation.ts) hits
# every 10 minutes to keep a Render free-tier service from spinning down
# (see /api/health). On Render this is NOT needed — Render sets
# RENDER_EXTERNAL_URL automatically and instrumentation.ts falls back to
# it. Only set APP_BASE_URL to override that (e.g. a custom domain) or to
# self-ping on a non-Render host. Leave unset for local dev; the self-ping
# loop no-ops with no base URL.
# APP_BASE_URL="https://your-app.onrender.com"
